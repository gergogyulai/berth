---
// A screenshot that follows the page's colour scheme. `width` is the widest it is ever laid out, in
// CSS pixels; a 2x variant is generated alongside it.
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  light: ImageMetadata;
  dark?: ImageMetadata;
  alt: string;
  width: number;
  eager?: boolean;
}

const { light, dark, alt, width, eager = false } = Astro.props;

const widths = [...new Set([width, width * 2].map((w) => Math.min(w, light.width)))];

async function variants(src: ImageMetadata) {
  const images = await Promise.all(widths.map((w) => getImage({ src, width: w, format: "webp", quality: 86 })));
  return { src: images[0].src, srcset: images.map((image, i) => `${image.src} ${widths[i]}w`).join(", ") };
}

const lightSet = await variants(light);
const darkSet = dark ? await variants(dark) : undefined;
const sizes = `(max-width: ${width}px) 100vw, ${width}px`;
---

<picture>
  {darkSet && <source media="(prefers-color-scheme: dark)" srcset={darkSet.srcset} sizes={sizes} />}
  <img
    src={lightSet.src}
    srcset={lightSet.srcset}
    sizes={sizes}
    width={light.width}
    height={light.height}
    alt={alt}
    loading={eager ? "eager" : "lazy"}
    decoding={eager ? "sync" : "async"}
    fetchpriority={eager ? "high" : undefined}
  />
</picture>
